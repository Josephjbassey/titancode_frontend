# ═════════════════════════════════════════════════════════════════════════
# TitanCode Technologies — Frontend Environment Configuration
# ═════════════════════════════════════════════════════════════════════════
# In Vite, all client-exposed environment variables MUST be prefixed with VITE_

# ── 1. Backend API URL (CRITICAL) ──────────────────────────────────────
# For Local Development:
VITE_API_URL=http://localhost:8000

# For Staging/Production on Vercel:
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://titancode-backend.onrender.com

# ── 2. Google OAuth (Optional) ─────────────────────────────────────────
# Google Cloud Console OAuth 2.0 Web Client ID for "Sign in with Google"
# Leave empty if you only want email/password authentication
VITE_GOOGLE_CLIENT_ID=

# ── 3. Subdomain Routing (Optional) ────────────────────────────────────
# Set to 'true' only if deploying separate apex marketing (titancode.tech)
# and app workspace (app.titancode.tech) domains.
# Leave 'false' for single-domain deployments (e.g. *.vercel.app or localhost)
VITE_ENABLE_SUBDOMAIN_ROUTING=false
VITE_APP_SUBDOMAIN=app
VITE_ROOT_DOMAIN=titancode.tech
